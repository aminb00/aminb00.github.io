---
// Small inline icons for the Contact line. Drawn by hand (outline style, 24px
// grid, currentColor), no icon library and no request: they inherit the link
// color and stay crisp at any size. Decorative: the link text says what it is.
interface Props {
  name: 'mail' | 'linkedin' | 'github' | 'cv';
}

const { name } = Astro.props;
---
<svg class="icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {name === 'mail' && (
    <Fragment>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
    </Fragment>
  )}
  {name === 'linkedin' && (
    <Fragment>
      <rect x="3" y="3" width="18" height="18" rx="3" />
      <path d="M8 10.5V17M8 7.25v.01M12 17v-6.5M12 13.5c0-1.7 1.2-3 2.75-3S17 11.6 17 13.3V17" />
    </Fragment>
  )}
  {name === 'github' && (
    <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
  )}
  {name === 'cv' && (
    <Fragment>
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
      <path d="M14 3v5h5M9 13h6M9 17h4" />
    </Fragment>
  )}
</svg>
