---
// Every page: head, skip link, header (name, affiliation line, navigation),
// main, footer. The CSS is inlined: one request per page, no web fonts on
// machines that have Times New Roman.
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CSS } from '../lib/css';

export type Page = 'home' | 'experience' | 'projects' | 'presentations' | 'cv';

interface Props {
  title: string;
  description: string;
  page: Page;
  /** Replaces the affiliation line under the name (Home uses the role line). */
  line?: string;
  /** Structured data (JSON-LD), Home only. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, page, line, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Amin Borqal">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Amin Borqal, M.Sc. student, Computer Science and Engineering, University of Bergamo">
    <meta name="twitter:card" content="summary_large_image">
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <style is:inline set:html={CSS}></style>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <SiteHeader page={page} line={line} />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
