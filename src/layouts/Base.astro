---
// Every page: head, skip link, header (name, affiliation line, navigation),
// main, footer. The CSS is inlined: one request per page, no web fonts on
// machines that have Times New Roman.
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CSS } from '../lib/css';

export type Page = 'home' | 'experience' | 'projects' | 'presentations' | 'cv';

interface Props {
  title: string;
  description: string;
  page: Page;
  /** Replaces the affiliation line under the name (Home uses the role line). */
  line?: string;
}

const { title, description, page, line } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <style is:inline set:html={CSS}></style>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <SiteHeader page={page} line={line} />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
