---
import Base from '../layouts/Base.astro';
import Email from '../components/Email.astro';
import Icon from '../components/Icon.astro';
import NewsList from '../components/NewsList.astro';
import Portrait from '../components/Portrait.astro';
import SelectedWork from '../components/SelectedWork.astro';
import { getSite } from '../lib/site';
import { fmtBytes } from '../lib/format';

const site = await getSite();
const p = site.profile;
const university = (name: string) => ({ '@type': 'CollegeOrUniversity', name });
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: p.name,
  url: new URL('/', Astro.site).href,
  affiliation: university(p.affiliation),
  alumniOf: p.alumniOf.map(university),
  sameAs: [p.links.github, p.links.linkedin],
};
---
<Base
  title="Amin Borqal's Home Page"
  description="Amin Borqal, M.Sc. student in Computer Science and Engineering at the University of Bergamo: experience, projects, slides and CV."
  page="home"
  line={p.roleLine}
  jsonLd={person}
>
  <section>
    <h2>About</h2>
    <Portrait />
    <p>{p.thesisLine}</p>
    {p.bio.map((t) => <p data-verbatim set:html={site.text(t, 'profile.bio')} />)}
    <h3>Interests</h3>
    <ul>
      {p.interests.map((item) => <li>{item}</li>)}
    </ul>
  </section>
  <hr>
  <section>
    <h2>Contact</h2>
    <ul class="contact">
      <li class="mail"><Icon name="mail" /><Email copy /></li>
      <li><a href={p.links.linkedin}><Icon name="linkedin" /><span class="label">LinkedIn</span></a></li>
      <li><a href={p.links.github}><Icon name="github" /><span class="label">GitHub</span></a></li>
      {site.cv && (
        <li>
          <a href={site.cv.href}><Icon name="cv" /><span class="label">CV EN</span> <span class="size">PDF, {fmtBytes(site.cv.bytes)}</span></a>
        </li>
      )}
      {site.cvIt && (
        <li>
          <a href={site.cvIt.href} hreflang="it"><Icon name="cv" /><span class="label">CV IT</span> <span class="size">PDF, {fmtBytes(site.cvIt.bytes)}</span></a>
        </li>
      )}
    </ul>
  </section>
  <hr>
  <section>
    <h2>News &amp; updates</h2>
    <NewsList />
  </section>
  <hr>
  <section>
    <h2>Selected work</h2>
    <SelectedWork />
  </section>
  {p.offDuty && (
    <Fragment>
      <hr>
      <section>
        <h2>Off-duty</h2>
        <p set:html={site.text(p.offDuty, 'profile.offDuty')} />
      </section>
    </Fragment>
  )}
</Base>
